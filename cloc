#!/bin/zsh

dir=$1
lang=$2
ext=""

case $lang in
    java) ext="java" ;;
    c)    ext="c" ;;
    cpp)  ext="cpp" ;;
    py)   ext="py" ;;
    js)   ext="js" ;;
    *)    echo -e "\033[31mUnknown language:\033[0m $lang"; exit 1 ;;
esac

echo -e "\033[36mCounting lines in\033[0m \033[35m$lang\033[0m \033[36mproject under\033[0m \033[34m$dir\033[0m"
echo "---------------------------------------------------------"

total=0

for file in $(find "$dir" -type f -name "*.$ext"); do
    count=$(wc -l < "$file")
    total=$((total + count))
    printf "\033[33m%-40s\033[0m %6d lines\n" "$file" "$count"
done

echo "---------------------------------------------------------"
printf "\033[33mTOTAL:\033[0m \033[31m%d\033[0m lines\n" "$total"

